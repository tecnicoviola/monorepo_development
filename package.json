
{
  "name": "my-turborepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && bunx prisma generate",
    "start:web": "cd apps/web && bun run dev",
    "start:backend": "cd apps/backend && bun run dev",
    "start:websocket": "cd apps/ws && bun run dev"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
